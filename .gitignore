# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files
.env.local
.env*.local

# Heavy raw design source assets (optimized copies live in public/landing/opt)
/_design-sources/

# Lossless PNG copies of the optimized landing images. Pure derived output:
# regenerate with `node scripts/opt-to-png.mjs` from the tracked avif/webp
# sources in the same folder (1.6MB of sources, 11MB of PNGs).
/public/landing/opt/png/

# Copy round-trip working files: regenerate with `npm run copy:export`.
/project-copy.csv
/project-copy-case-studies.csv
